# Port the simulator listens on for Curis → SMART webhooks + its own
# /sim/* control endpoints. 6021 keeps clear of Curis BE (6011) and FE (6010).
PORT=6021

# SQLite database file. Holds the shadow state + full audit trail and
# survives restarts. Delete the file (and any -wal / -shm siblings) for a
# clean slate. WAL-mode is on by default.
DB_FILE=./data/sim.db

# Base URL for outbound SMART → Curis claim submissions.
CURIS_BASE_URL=http://localhost:6011

# Operator (tenant) we're pretending to be SMART for. Curis routes the
# webhook to one operator via the URL path:
#   POST /api/v1/smart/{CURIS_OPERATOR_CODE}/claims
CURIS_OPERATOR_CODE=

# HMAC secret used to sign outbound claim posts to Curis. Must match the
# operator's smart_webhook_secret stored in Curis (rotated via the SA
# operator endpoint).
CURIS_INBOUND_SECRET=

# HMAC secret Curis uses to sign its outbound events to us. Verified on
# every inbound /smart/webhooks/* request. Must match the operator's
# smart_outbound_secret stored in Curis.
SMART_OUTBOUND_SECRET=
